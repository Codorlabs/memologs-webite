8:["$","blockquote",null,{"className":"cs-pull","children":["“We analyzed campaigns driving 95% of installs. The frequency capping alone brought immediate efficiency — then the creative refresh queue and the branded search reallocation stacked on top. Every month since, the number has gotten cleaner, not noisier.”",["$","br",null,{}],["$","cite",null,{"style":{"fontFamily":"var(--mono)","fontSize":"12px","letterSpacing":".12em","textTransform":"uppercase","color":"var(--ink-3)","fontStyle":"normal"},"children":"— VP Growth · Consumer fintech app"}]]}]
