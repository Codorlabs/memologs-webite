0:{"rsc":["$","$1","c",{"children":[[["$","section",null,{"className":"cs-hero","children":["$","div",null,{"className":"wrap","children":[["$","div",null,{"className":"sp-breadcrumb","children":[["$","$L2",null,{"href":"/case-studies","children":"Case studies"}]," ",["$","span",null,{"children":"›"}]," Fintech"]}],["$","span",null,{"className":"cs-industry","children":"Fintech"}],["$","h1",null,{"style":{"fontFamily":"var(--serif)","fontWeight":400,"fontSize":"clamp(40px,4.6vw,64px)","lineHeight":1.03,"letterSpacing":"-0.01em","margin":"24px 0 0","maxWidth":"900px"},"children":"A unicorn fintech cut CPI 37% and increased click-to-acquisition 30% in one quarter."}],["$","div",null,{"className":"cs-stats","children":[["$","div",null,{"className":"cs-stat","children":[["$","div",null,{"className":"cs-stat-num","children":"−37%"}],["$","div",null,{"className":"cs-stat-lab","children":"Cost per install"}]]}],["$","div",null,{"className":"cs-stat","children":[["$","div",null,{"className":"cs-stat-num","children":"+30%"}],["$","div",null,{"className":"cs-stat-lab","children":"Click-to-acquisition"}]]}],["$","div",null,{"className":"cs-stat","children":[["$","div",null,{"className":"cs-stat-num","children":"95%"}],["$","div",null,{"className":"cs-stat-lab","children":"Install spend audited"}]]}],["$","div",null,{"className":"cs-stat","children":[["$","div",null,{"className":"cs-stat-num","children":"< 5wk"}],["$","div",null,{"className":"cs-stat-lab","children":"Time to first result"}]]}]]}]]}]}],["$","section",null,{"children":["$","div",null,{"className":"wrap","children":["$","div",null,{"className":"cs-body","children":[["$","div",null,{"className":"cs-tag","children":"Challenge"}],["$","div",null,{"children":[["$","h2",null,{"children":"What wasn't working."}],["$","p",null,{"children":"The client — a late-stage consumer fintech running $1.2M/mo in paid acquisition across Meta, Google, and TikTok — had hit a wall. CPI had climbed 22% over two quarters despite no change in creative or targeting strategy. Platform dashboards were inconsistent: Meta Ads Manager claimed a $6 CPI, GA4 said $11, and their CRM suggested something in between."}],["$","p",null,{"children":"Worse, their VP of Growth had just left. Institutional memory of why previous scale-ups failed was walking out the door."}]]}],["$","div",null,{"className":"cs-tag","children":"Approach"}],["$","div",null,{"children":[["$","h2",null,{"children":"What we did."}],["$","p",null,{"children":"We started with a full attribution audit on the 95% of install spend concentrated in Meta and Google. Signal Recovery was deployed in week one to rebuild server-side tracking across both platforms."}],["$","p",null,{"children":"In week two, Creative IQ identified four fatiguing ad sets that accounted for 38% of spend — their 7-signal health scores had all dropped below 30. We queued refresh variants and began A/B testing immediately."}],["$","p",null,{"children":"Weeks 3–5, we ran the first geo-lift study to establish true incremental CPI versus platform-reported CPI. Dual-model consensus (GeoLift + CausalImpact) returned an Attribution Inflation Factor of 2.8× on Meta and 4.1× on branded Google search."}],["$","div",null,{"className":"cs-pull","children":"“Meta claimed a $6 CPI. Geo-lift said $17. Once we stopped optimizing against the lie, everything got better.”"}],["$","p",null,{"children":"The reallocation plan: cap branded search at 60% of its prior budget, move the surplus into Meta prospecting creative that had tested well in the fatigue-replacement cohort, and add frequency caps at the audience level."}]]}],["$","div",null,{"className":"cs-tag","children":"Results"}],["$","div",null,{"children":[["$","h2",null,{"children":"What changed."}],["$","p",null,{"children":"By end of Q2, CPI on the recovered-signal basis had dropped from $17 (true incremental) to $10.70 — a 37% improvement. Click-to-acquisition improved 30% as the refreshed creatives and tightened frequency caps lifted relevance."}],["$","table",null,{"className":"cs-table","children":[["$","thead",null,{"children":["$","tr",null,{"children":["$L3","$L4","$L5","$L6"]}]}],"$L7"]}],"$L8"]}]]}]}]}],"$L9"],null,"$La"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"o92qp_NekArx7nWc5OMUy"}
