f:["$","$1","c",{"children":[[["$","section",null,{"className":"cs-hero","children":["$","div",null,{"className":"wrap","children":[["$","div",null,{"className":"sp-breadcrumb","children":[["$","$L5",null,{"href":"/case-studies","children":"Case studies"}]," ",["$","span",null,{"children":"›"}]," Multi-brand retail"]}],["$","span",null,{"className":"cs-industry","children":"Multi-brand retail"}],["$","h1",null,{"style":{"fontFamily":"var(--serif)","fontWeight":400,"fontSize":"clamp(40px,4.6vw,64px)","lineHeight":1.03,"letterSpacing":"-0.01em","margin":"24px 0 0","maxWidth":"900px"},"children":"India's largest watch retailer hit 1.6× ROAS and 40% YoY revenue growth across 8 brand lines."}],["$","div",null,{"className":"cs-stats","children":[["$","div",null,{"className":"cs-stat","children":[["$","div",null,{"className":"cs-stat-num","children":"1.6×"}],["$","div",null,{"className":"cs-stat-lab","children":"ROAS lift"}]]}],["$","div",null,{"className":"cs-stat","children":[["$","div",null,{"className":"cs-stat-num","children":"+40%"}],["$","div",null,{"className":"cs-stat-lab","children":"YoY revenue"}]]}],["$","div",null,{"className":"cs-stat","children":[["$","div",null,{"className":"cs-stat-num","children":"4 → 9"}],["$","div",null,{"className":"cs-stat-lab","children":"Google Quality Score"}]]}],["$","div",null,{"className":"cs-stat","children":[["$","div",null,{"className":"cs-stat-num","children":"8"}],["$","div",null,{"className":"cs-stat-lab","children":"Brand lines supported"}]]}]]}]]}]}],["$","section",null,{"children":["$","div",null,{"className":"wrap","children":["$","div",null,{"className":"cs-body","children":[["$","div",null,{"className":"cs-tag","children":"Challenge"}],["$","div",null,{"children":[["$","h2",null,{"children":"What wasn't working."}],["$","p",null,{"children":"The client managed paid marketing for 8 distinct watch brands — ranging from mass-market to premium Swiss — under one holding company. Each brand had different audiences, price points, and conversion motions, but paid search was being managed with a single generic keyword structure and a single generic creative template."}],["$","p",null,{"children":"Result: Google Quality Score averaged 4, CPCs were 2.3× benchmark, and the shared account was consuming budget that could have driven much higher-intent traffic to each brand line individually."}]]}],["$","div",null,{"className":"cs-tag","children":"Approach"}],["$","div",null,{"children":[["$","h2",null,{"children":"What we did."}],["$","p",null,{"children":"We rebuilt the account structure around SKU-level keyword grouping. Every brand got its own campaign tree, and within each, SKU families (dive watches, dress, chronograph, etc.) got their own ad groups with tailored messaging."}],["$","p",null,{"children":"Audience IQ enriched the first-party purchase history across all 8 brands, then built cross-brand cross-sell segments — customers who bought a mid-tier dress watch showed strong intent signals for the premium line 9–14 months later."}],["$","p",null,{"children":"Creative IQ handled the ad variants at scale: 300+ ad groups would have been impossible to monitor manually. Health scoring at the asset level meant refresh budget went to the specific SKU groups where it was needed."}]]}],["$","div",null,{"className":"cs-tag","children":"Results"}],["$","div",null,{"children":[["$","h2",null,{"children":"What changed."}],["$","p",null,{"children":"Google Quality Score climbed from 4 to 9 across the restructured account within 10 weeks. CPC dropped 34%. ROAS improved from 3.1× to 4.9× — a 1.6× lift. Year-over-year revenue across the brand portfolio grew 40%."}],["$","table",null,{"className":"cs-table","children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Metric"}],["$","th",null,{"children":"Before"}],["$","th",null,{"children":"After 90 days"}],["$","th",null,{"children":"Change"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","