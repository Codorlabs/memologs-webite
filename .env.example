BACKEND_URL=http://localhost:8000

# ──────────────────────────────────────────────────────────────────────────
# Analytics
# Set a platform's id to enable it. Meta is on by default.
# ──────────────────────────────────────────────────────────────────────────

# Meta (Facebook) Pixel id — also used as the Zaraz Conversions API pixel id.
NEXT_PUBLIC_META_PIXEL_ID=1005901432009535

# Google Analytics 4 — e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google Ads conversion id — e.g. AW-XXXXXXXXXX
# (per-event conversion labels live in lib/analytics/config.ts -> googleAds.labels)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# TikTok Pixel id
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Set to "true" to hold all events until analytics.setConsent(true) is called.
NEXT_PUBLIC_ANALYTICS_REQUIRE_CONSENT=
